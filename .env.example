# ───────── ローカル開発（Homebrew の PostgreSQL） ─────────
# <ユーザー名> は `whoami` の結果に置き換える
DATABASE_URL="postgresql://<ユーザー名>@localhost:5432/sakumon?schema=public"
DIRECT_URL="postgresql://<ユーザー名>@localhost:5432/sakumon?schema=public"

# ───────── 本番（Neon などのクラウド PostgreSQL）に切り替える場合 ─────────
# DATABASE_URL はプール経由（ホスト名に -pooler が付くもの）、
# DIRECT_URL はプールを通さない直接接続を指定する。
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require"
